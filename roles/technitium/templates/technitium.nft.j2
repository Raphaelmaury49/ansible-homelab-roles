# {{ ansible_managed }} (role technitium)
table inet filter {
  chain input {
    ip saddr { {{ technitium_dns_sources | join(', ') }} } udp dport 53 accept comment "dns-udp"
    ip saddr { {{ technitium_dns_sources | join(', ') }} } tcp dport 53 accept comment "dns-tcp"
{% if technitium_web_sources %}
    ip saddr { {{ technitium_web_sources | join(', ') }} } tcp dport {{ technitium_web_port }} accept comment "technitium-web"
{% endif %}
  }
}
