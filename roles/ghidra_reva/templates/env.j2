GHIDRA_INSTALL_DIR={{ ghidra_reva_dir }}/ghidra
REVA_CONFIG={{ ghidra_reva_dir }}/reva.properties
REVA_PROJECT_DIR={{ ghidra_reva_data }}/projects
REVA_PROJECT_NAME={{ ghidra_reva_project_name }}
REVA_API_KEY={{ ghidra_reva_api_key }}
REVA_INTERNAL_PORT={{ ghidra_reva_internal_port }}
REVA_DISABLED_TOOL_GROUPS={{ ghidra_reva_disabled_tool_groups | join(',') }}
REVA_VMARGS=-Xmx{{ ghidra_reva_heap }} -Xrs -Djava.awt.headless=true
REVA_SAMPLES={{ ghidra_reva_data }}/samples
MCP_UPSTREAM_KEY={{ ghidra_reva_upstream_key }}
BIND_HOST={{ ghidra_reva_bind }}
BIND_PORT={{ ghidra_reva_port }}
