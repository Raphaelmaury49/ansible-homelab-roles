# {{ ansible_managed }} (role netboot)
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root {{ netboot_http_dir }};
    index index.html;
    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;
    sendfile on;
    tcp_nopush on;

    location ~ \.ipxe$ {
        default_type text/plain;
        add_header Cache-Control "no-store";
    }

    location = /status.json {
        add_header Cache-Control "no-store";
    }

    # Liste JSON des ISOs pour la page web
    location /api/iso/ {
        alias {{ netboot_iso_dir }}/;
        autoindex on;
        autoindex_format json;
        add_header Cache-Control "no-store";
    }

    location /iso/ {
        alias {{ netboot_iso_dir }}/;
        autoindex on;
        autoindex_exact_size off;
    }
}
