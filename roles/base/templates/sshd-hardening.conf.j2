# {{ ansible_managed }} (role base)
{% if base_ssh_port != 22 %}
Port {{ base_ssh_port }}
{% endif %}
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin {{ 'no' if base_disable_root_login else 'prohibit-password' }}
AllowUsers {{ base_admin_user }}{{ '' if base_disable_root_login else ' root' }}
MaxAuthTries 3
X11Forwarding no
