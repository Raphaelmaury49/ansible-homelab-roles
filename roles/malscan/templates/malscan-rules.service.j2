[Unit]
Description=Maj des regles YARA/capa (malscan)

[Service]
Type=oneshot
User=root
Environment=MALSCAN_YARA_URL={{ malscan_yara_url }}
Environment=MALSCAN_CAPA_RULES_URL={{ malscan_capa_rules_url }}
Environment=MALSCAN_CAPA_RULES_DIR={{ malscan_capa_rules_dir }}
ExecStart={{ malscan_dir }}/app/update-rules.sh {{ malscan_data }}/yara
